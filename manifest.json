{
  "manifest_version": 3,
  "name": "Stay Focus",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "description": "Block chosen websites with daily sessions and a Pomodoro focus timer.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": ["storage", "alarms", "declarativeNetRequest", "tabs"],
  "web_accessible_resources": [{
    "resources": ["blocked.html", "src/blocked.js", "src/styles.css", "src/vendor/mdo/*.css"],
    "matches": ["<all_urls>"]
  }],
  "action": {
    "default_title": "Stay Focus",
    "default_icon": "assets/icon-32.png",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  }
}
